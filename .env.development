# Local development runs fully self contained: mock auth, mock API, role preview bar.
# Empty base URL keeps requests same origin so the MSW worker intercepts them.
# Endpoint paths in src/api/endpoints.ts already carry the /api prefix.
VITE_API_BASE_URL=
VITE_ENABLE_MOCKS=true
VITE_AUTH_MODE=mock
VITE_ENABLE_ROLE_PREVIEW=true
