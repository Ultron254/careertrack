# Standalone demo deployment (Vercel), built with: vite build --mode demo.
# Runs the whole product on mock data with no backend and no Entra tenant, so
# every screen and role is reachable for review. When the real backend exists,
# switch vercel.json buildCommand back to "npm run build" and use .env.production.
VITE_API_BASE_URL=
VITE_ENABLE_MOCKS=true
VITE_AUTH_MODE=mock
VITE_ENABLE_ROLE_PREVIEW=true
