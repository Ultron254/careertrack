# Base URL every API request is made against. The mock worker intercepts
# requests to this origin when mocks are on; point it at the real backend
# during handover.
VITE_API_BASE_URL=/api

# true: MSW intercepts fetch and serves fixture data. false: requests hit
# VITE_API_BASE_URL directly.
VITE_ENABLE_MOCKS=true

# mock: fixture user, no tenant needed. msal: Microsoft Entra ID sign in.
VITE_AUTH_MODE=mock

# Shows the "Demo, view as" role switcher. Development convenience only,
# keep false in production.
VITE_ENABLE_ROLE_PREVIEW=true

# Entra ID app registration. Required only when VITE_AUTH_MODE=msal.
# Values come from the Azure portal: App registrations > CareerTrack.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_ENTRA_API_SCOPE=api://careertrack/.default
